# ============================================================
# Air Quality Monitoring — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# -- ThingSpeak --
THINGSPEAK_CHANNEL_ID=YOUR_CHANNEL_ID_HERE
THINGSPEAK_READ_API_KEY=YOUR_READ_API_KEY_HERE

# -- Sensor Location (defaults: NMIT Yelahanka) --
# LATITUDE=13.1291
# LONGITUDE=77.5865
# LOCATION_NAME=NMIT, Yelahanka, Bengaluru

# -- Open-Meteo cache (seconds, default 600 = 10 min) --
# OPEN_METEO_CACHE_SECONDS=600

# -- MQ-135 raw threshold (default 600) --
# MQ135_THRESHOLD=600

# -- Flask --
# FLASK_DEBUG=false
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5000
